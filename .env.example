# Local
DATABASE_URL="postgresql://USER@localhost:5432/samsun_sosyal_medya?schema=public"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@samsunsosyalmedya.com"
ADMIN_PASSWORD="change-me"
# Canonical public site (sitemap, OG, schema). Localhost/staging kabul edilmez.
NEXT_PUBLIC_SITE_URL="https://samsunsosyalmedya.com"
NEXT_PUBLIC_GTM_ID="GTM-M2W8R68W"
# Optional: absolute path for admin uploads (default: ./uploads). Served at /media/*
# UPLOAD_DIR="/var/lib/samsun/uploads"

# --- Coolify / production (set in Coolify UI, do not commit) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
# AUTH_SECRET=<long-random>
# AUTH_URL=https://samsunsosyalmedya.com
# NEXT_PUBLIC_SITE_URL=https://samsunsosyalmedya.com
# NEXT_PUBLIC_GTM_ID=GTM-M2W8R68W
# UPLOAD_DIR=/app/uploads
# Coolify Persistent Storage: mount volume → /app/uploads
# ADMIN_EMAIL / ADMIN_PASSWORD — only needed for one-time seed


# Wesoco SEO Agent — panel bağlantısı (.env.local / Coolify WEB app)
SEO_AGENT_SITE_KEY=
SEO_AGENT_SECRET=
SEO_AGENT_PUBLIC_URL="https://samsunsosyalmedya.com"
SEO_AGENT_DATA_DIR=".data/seo-agent"
# Coolify: SEO_AGENT_DATA_DIR="/app/uploads/seo-agent"
INDEXNOW_KEY=
